[
    {
        "question": "统计每个机构2024年的全血采集人次",
        "must_include_tables": [
            "Stat_Collection",
            "Pub_OrgAddress"
        ],
        "must_include_columns": [
            "BTSID",
            "InstID",
            "OrgName"
        ],
        "must_include_filters": [
            "BCType = '0'",
            "BCDate >= '2024-01-01'",
            "BCDate < '2025-01-01'"
        ],
        "must_include_joins": [
            "Stat_Collection.BTSID = Pub_OrgAddress.InstID"
        ],
        "must_execute": true,
        "baseline_sql": "SELECT b.InstID AS InstID, b.OrgName AS InstName, COUNT(*) AS Times FROM Stat_Collection a JOIN Pub_OrgAddress b ON a.BTSID = b.InstID WHERE a.BCDate >= '2024-01-01' AND a.BCDate < '2025-01-01' AND a.BCType = '0' GROUP BY b.InstID, b.OrgName",
        "expected_result_columns": [
            "InstID",
            "InstName",
            "Times"
        ],
        "must_have_group_by": true,
        "must_not_include_columns": [
            "BCPVolume",
            "District"
        ],
        "must_not_contain": [
            "data_2024",
            "data_2025"
        ],
        "should_refuse": false
    },
