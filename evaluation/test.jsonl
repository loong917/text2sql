{"id":"test-institution-component-volume-2025","split":"test","category":"aggregation_join","difficulty":"medium","question":"统计每个机构2025年的成分血采集量","expected_semantic_ir":{"metric":"collection_volume","dimensions":["institution"],"year":2025,"blood_type":"component"},"baseline_sql":"SELECT b.InstID AS InstID,b.OrgName AS InstName,SUM(a.BCPVolume) AS Volume FROM Stat_Collection a JOIN Pub_OrgAddress b ON a.BTSID=b.InstID WHERE a.BCDate>='2025-01-01' AND a.BCDate<'2026-01-01' AND a.BCType='1' GROUP BY b.InstID,b.OrgName","must_include_tables":["Stat_Collection","Pub_OrgAddress"],"must_include_columns":["BCPVolume","OrgName"],"must_include_filters":["BCType = '1'","BCDate >= '2025-01-01'","BCDate < '2026-01-01'"],"must_include_joins":["Stat_Collection.BTSID = Pub_OrgAddress.InstID"],"expected_result_columns":["InstID","InstName","Volume"],"must_have_group_by":true,"must_execute":true,"should_refuse":false,"status":"approved"}
