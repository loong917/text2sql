# ===== LLM 配置 =====
LLM_MODEL=deepseek-r1:7b
LLM_HOST=http://localhost:11434

# ===== Agent 记忆 =====
MEMORY_DB_DIR=./vanna_memory_db
MEMORY_COLLECTION=vanna_agent_memory

# ===== 数据库连接 =====
MSSQL_CONN_STR=Driver={ODBC Driver 17 for SQL Server};Server=YOUR_HOST;Database=Text2SQL;UID=sa;PWD=YOUR_PASSWORD;TrustServerCertificate=yes;Encrypt=no;

# ===== 服务配置 =====
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
LOG_LEVEL=INFO
TIMEOUT_KEEP_ALIVE=5
