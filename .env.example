# ===== LLM 配置 =====
# 推荐使用 qwen2.5-coder:7b 等支持 Tool Calling 的模型
LLM_MODEL=qwen2.5-coder:14b
LLM_MODEL_DIGEST=
LLM_HOST=http://localhost:11434
LLM_TIMEOUT_SECONDS=180

# 嵌入模型配置（通过 Ollama 本地运行，推荐 bge-m3 或 nomic-embed-text）
EMBEDDING_MODEL=bge-m3
EMBEDDING_MODEL_DIGEST=
TABLE_RETRIEVAL_CALIBRATOR_PATH=./vanna_knowledge_db/table_retrieval_calibrator.json
RETRIEVAL_CALIBRATION_SET_PATH=./evaluation/retrieval_calibration.jsonl
RETRIEVAL_TEST_SET_PATH=./evaluation/retrieval_test.jsonl
TABLE_RETRIEVAL_TOKEN_BUDGET=2400
TABLE_RETRIEVAL_REQUIRE_CALIBRATION=true
# auto 优先实时数据库并在失败时回退；snapshot 直接使用受版本控制的 Schema 快照
TABLE_RETRIEVAL_TRAIN_SCHEMA_SOURCE=auto
TABLE_RETRIEVAL_MAX_FALSE_POSITIVE_RATE=0.25

# 知识库目录（Schema + 文档 + 样本数据）
KNOWLEDGE_DB_DIR=./vanna_knowledge_db
KNOWLEDGE_ARTIFACT_DIR=./vanna_knowledge_db/artifacts
KNOWLEDGE_ACTIVE_POINTER_PATH=./vanna_knowledge_db/active_artifact.json
# 发布后保留最近版本数；活动版本始终保留
KNOWLEDGE_ARTIFACT_RETENTION_COUNT=5
# 训练进程异常退出后，锁超过该秒数可被下一次训练回收
KNOWLEDGE_TRAINING_LOCK_STALE_SECONDS=7200
SCHEMA_SNAPSHOT_PATH=./knowledge/schema/schema_snapshot.json

# Agent 记忆目录（对话历史）
AGENT_MEMORY_DIR=./vanna_agent_memory
AGENT_COLLECTION=agent_memory

# ===== 数据库连接 =====
# 注意：Docker 镜像内安装的是 ODBC Driver 18；本机运行请与已安装驱动保持一致
# 生产环境请使用只读数据库账号（仅授予 SELECT + VIEW DEFINITION 权限）
MSSQL_CONN_STR=Driver={ODBC Driver 18 for SQL Server};Server=YOUR_HOST;Database=YOUR_DATABASE;UID=YOUR_USER;PWD=YOUR_PASSWORD;Encrypt=yes;TrustServerCertificate=no;

# ===== 服务配置 =====
APP_ENV=development
APP_REVISION=unknown
SERVER_HOST=0.0.0.0
SERVER_PORT=8090
LOG_LEVEL=INFO
TIMEOUT_KEEP_ALIVE=5

# ===== 生产加固 =====
# 本地 Ollama 同时处理的生成请求数（超过则排队）
LLM_MAX_CONCURRENCY=2
LLM_NUM_CTX=8192
LLM_NUM_PREDICT=1024
LLM_KEEP_ALIVE=15m
# 单次查询返回的最大行数（超出截断，响应中 result_truncated=true）
MAX_RESULT_ROWS=500
SQL_QUERY_TIMEOUT_SECONDS=30
SQL_MAX_CONCURRENCY=4
SQL_POOL_SIZE=5
SQL_MAX_OVERFLOW=5
SQL_POOL_RECYCLE_SECONDS=1800
SQL_MAX_JOINS=8
SQL_MAX_SUBQUERIES=6
SQL_ALLOWED_SCHEMAS=dbo
# 空值表示由实时 Schema 决定；生产环境建议显式列出可查询业务表
SQL_ALLOWED_TABLES=Stat_Collection,Pub_OrgAddress
SQL_DENIED_TABLES=
# 格式为 Table.Column，支持 *.Column 禁止任意表中的同名敏感字段；请按真实数据字典补全
SQL_DENIED_COLUMNS=*.Password,*.Token,*.Secret,*.Phone,*.Mobile,*.IDCard
# 列出的表必须出现在至少包含一个聚合函数的查询中
SQL_AGGREGATION_ONLY_TABLES=Stat_Collection
SQL_ALLOW_SELECT_STAR=false
SQL_REQUIRE_TABLE=true
SQL_ALLOW_CROSS_JOIN=false
# 实时 schema 缓存有效期（秒），0 表示永不过期
SCHEMA_CACHE_TTL_SECONDS=300
# 注入 prompt 的已验证反馈样本条数（0 表示关闭）
PROMPT_FEEDBACK_EXAMPLES=3
# 生产环境三项均至少 32 字符；浏览器使用 HttpOnly 会话，API 客户端使用请求头
# /ask /generate-sql /feedback /training-report 使用 X-API-Key
API_KEY=
# Gold 审核使用独立的 X-Admin-API-Key 或 admin 会话
FEEDBACK_ADMIN_API_KEY=
WEB_SESSION_SECRET=
WEB_SESSION_TTL_SECONDS=28800
# HTTPS 生产环境必须为 true；本地 HTTP 调试保持 false
WEB_SESSION_COOKIE_SECURE=false


# ===== 结构化知识库（运行时首选） =====
STRUCTURED_KNOWLEDGE_DIR=./knowledge

# ===== 训练配置 =====
RETRIEVAL_TRAIN_SET_PATH=./evaluation/retrieval_train.jsonl
EVAL_DEV_SET_PATH=./evaluation/dev.jsonl
EVAL_TEST_SET_PATH=./evaluation/test.jsonl
EVAL_TEST_REPORT_PATH=./vanna_knowledge_db/test-report-latest.json
PRODUCTION_READINESS_REPORT_PATH=./vanna_knowledge_db/production-readiness.json
PRODUCTION_RELEASE_MANIFEST_PATH=./vanna_knowledge_db/production-release.json
# 发布评测质量门禁（text2sql-evaluate --enforce-gate）
EVAL_MIN_PASS_RATE=0.85
EVAL_MIN_POSITIVE_PASS_RATE=0.85
EVAL_MIN_REFUSAL_PASS_RATE=0.95
EVAL_MIN_CASES=4
EVAL_MIN_POSITIVE_CASES=3
EVAL_MIN_REFUSAL_CASES=1
EVAL_MIN_SEMANTIC_IR_PASS_RATE=1.0
EVAL_MIN_EXECUTION_PASS_RATE=0.85
EVAL_MIN_RETRIEVAL_RECALL=0.9
# 正式发布的冻结测试集数量门禁；不足时 release-check 必须失败
PRODUCTION_EVAL_MIN_CASES=100
PRODUCTION_EVAL_MIN_POSITIVE_CASES=80
PRODUCTION_EVAL_MIN_REFUSAL_CASES=20
PRODUCTION_RETRIEVAL_CALIBRATION_MIN_CASES=30
PRODUCTION_RETRIEVAL_TEST_MIN_CASES=30
# 训练流程固定使用 dev；冻结 test 只能通过 text2sql-evaluate --split test 执行
TRAINING_EVAL_SPLIT=dev
TRAINING_STATE_PATH=./vanna_knowledge_db/training_state.json
TRAINING_SKIP_UNCHANGED=true
# 自动执行、人工复核与 Gold/Negative 样本写入同一事务数据库。
FEEDBACK_DB_PATH=./vanna_knowledge_db/feedback.sqlite3


TRAINING_TABLES=
SAMPLE_TABLES=
PROFILING_MAX_DISTINCT_VALUES=12
PROFILING_MAX_TABLES=24
PROFILING_MAX_COLUMNS_PER_TABLE=8
# 数据画像默认关闭；仅显式白名单字段可读取样本/范围。格式: Table.Column,*.Column
PROFILING_ALLOWED_COLUMNS=
PROFILING_DENIED_COLUMNS=*.Name,*.Phone,*.Mobile,*.Address,*.IDCard,*.DonorID

# 反馈样本门禁
ENABLE_FEEDBACK_CAPTURE=true
FEEDBACK_REQUIRE_EXECUTION_SUCCESS=true
FEEDBACK_REQUIRE_NONEMPTY_RESULT=true
FEEDBACK_MIN_RESULT_ROWS=1
FEEDBACK_MIN_QUALITY_SCORE=75
