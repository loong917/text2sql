# ===== LLM 配置 =====
# 推荐使用 qwen2.5-coder:7b 等支持 Tool Calling 的模型
LLM_MODEL=qwen2.5-coder:14b
LLM_HOST=http://localhost:11434
LLM_TIMEOUT_SECONDS=180

# 嵌入模型配置（通过 Ollama 本地运行，推荐 bge-m3 或 nomic-embed-text）
EMBEDDING_MODEL=bge-m3

# 知识库目录（Schema + 文档 + 样本数据）
KNOWLEDGE_DB_DIR=./vanna_knowledge_db
KNOWLEDGE_COLLECTION=knowledge_memory

# Agent 记忆目录（对话历史）
AGENT_MEMORY_DIR=./vanna_agent_memory
AGENT_COLLECTION=agent_memory

# ===== 数据库连接 =====
# 注意：Docker 镜像内安装的是 ODBC Driver 18；本机运行请与已安装驱动保持一致
# 生产环境请使用只读数据库账号（仅授予 SELECT + VIEW DEFINITION 权限）
MSSQL_CONN_STR=Driver={ODBC Driver 18 for SQL Server};Server=YOUR_HOST;Database=YOUR_DATABASE;UID=YOUR_USER;PWD=YOUR_PASSWORD;TrustServerCertificate=yes;Encrypt=no;

# ===== 服务配置 =====
SERVER_HOST=0.0.0.0
SERVER_PORT=8090
LOG_LEVEL=INFO
TIMEOUT_KEEP_ALIVE=5

# ===== 生产加固 =====
# 本地 Ollama 同时处理的生成请求数（超过则排队）
LLM_MAX_CONCURRENCY=2
LLM_NUM_CTX=8192
LLM_NUM_PREDICT=1024
LLM_KEEP_ALIVE=15m
# 单次查询返回的最大行数（超出截断，响应中 result_truncated=true）
MAX_RESULT_ROWS=500
# 实时 schema 缓存有效期（秒），0 表示永不过期
SCHEMA_CACHE_TTL_SECONDS=300
# 注入 prompt 的已验证反馈样本条数（0 表示关闭）
PROMPT_FEEDBACK_EXAMPLES=3
# 可选 API Key，配置后 /ask /generate-sql /feedback-validation /training-report 需携带 X-API-Key 请求头
API_KEY=


# ===== 训练配置 =====
BUSINESS_DOC_PATH=./QUESTION.MD
DDL_DOC_PATH=./DDL.MD
EVAL_SET_PATH=./EVAL_SET.json
TRAINING_STATE_PATH=./vanna_knowledge_db/training_state.json
AUTO_QUESTION_EXPANSIONS_PATH=./vanna_knowledge_db/auto_question_expansions.json
TRAINING_SKIP_UNCHANGED=true
FEEDBACK_REVIEW_PATH=./vanna_knowledge_db/feedback_reviews.jsonl
# 自动执行成功仅进入待审层；人工确认正确后才晋升 Gold（FEEDBACK_EXAMPLES_PATH）
FEEDBACK_PENDING_PATH=./vanna_knowledge_db/feedback_pending.jsonl
FEEDBACK_NEGATIVE_PATH=./vanna_knowledge_db/feedback_negative.jsonl


TRAINING_TABLES=
PROFILING_MAX_DISTINCT_VALUES=12
PROFILING_MAX_TABLES=24
PROFILING_MAX_COLUMNS_PER_TABLE=8

# 反馈样本门禁
ENABLE_FEEDBACK_CAPTURE=true
FEEDBACK_REQUIRE_EXECUTION_SUCCESS=true
FEEDBACK_REQUIRE_NONEMPTY_RESULT=true
FEEDBACK_MIN_RESULT_ROWS=1
FEEDBACK_MIN_QUALITY_SCORE=75
